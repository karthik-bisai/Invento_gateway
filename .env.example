# Copy to gateway/.env. Every value has a safe development default, so you can start with an empty file.
# The gateway reads this file when it starts: restart it after editing.

# --- Where things are -------------------------------------------------------
HOST=127.0.0.1
PORT=4000
# The FastAPI service. It should not be reachable from the internet; only the gateway talks to it.
UPSTREAM_URL=http://localhost:8000
# The browser app. Used for CORS and for links inside emails.
APP_URL=http://localhost:5173
# Extra allowed origins, comma separated (defaults to APP_URL).
# CORS_ORIGINS=

# --- Secrets (must be changed in production) ---------------------------------
# Must equal INTERNAL_API_KEY in backend/.env.
INTERNAL_API_KEY=dev-internal-key
# Signs OTP hashes and CSRF tokens. Independent of the API's SECRET_KEY.
GATEWAY_SECRET=dev-gateway-secret-change-me

# --- Sessions ---------------------------------------------------------------
# Redis keeps sessions across restarts and across several gateways. If it is configured but not running, development
# falls back to in-memory sessions (with a warning); production refuses to start.
# `python run.py` in the backend folder starts Redis for you, or install it natively (Memurai on Windows).
REDIS_URL=redis://localhost:6379/1
SESSION_IDLE_HOURS=168
SESSION_MAX_DAYS=30
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# Only when the app and gateway are on sibling subdomains (e.g. .example.com). Disables the __Host- cookie prefix.
# COOKIE_DOMAIN=
# Honour X-Forwarded-For. Only behind a reverse proxy you control.
TRUST_PROXY=false

# --- Email codes (OTP): sign-up, sign-in by code, password reset --------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- Email: Gmail ------------------------------------------------------------
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an app password: Google Account -> Security -> 2-Step Verification -> App passwords.
# 3. Fill these two in (the spaces Google shows in the password are ignored) and uncomment the three lines.
# 4. Restart the gateway, then prove it works:   npm run mail:test -- you@example.com
# Gmail only sends as the signed-in account, and allows about 500 messages a day on a personal account.
# SMTP_PROVIDER=gmail
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Optional display name; the address part must be the Gmail account. Defaults to "Invento <SMTP_USER>".
# MAIL_FROM="Invento <your.address@gmail.com>"

# --- Email: any other SMTP server (use instead of Gmail) ----------------------
# With nothing set, emails are printed in the gateway terminal and saved under gateway/.dev-mail/ (nothing is sent).
# For a local inbox you can open in a browser: `python run.py --mail` in the backend folder, then SMTP_HOST=localhost SMTP_PORT=1025
# and browse http://localhost:8025.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Profile pictures -------------------------------------------------------
# local: files are saved under MEDIA_DIR and served by the gateway at /media/.
# s3:    files go to an S3 (or S3-compatible) bucket. See the README for the bucket policy and CDN setup.
STORAGE_DRIVER=local
MEDIA_DIR=./uploads
# Public base URL of stored files. MUST equal MEDIA_PUBLIC_URL in backend/.env (the API refuses other avatar URLs).
# For S3 this is the bucket's public/CDN address, e.g. https://cdn.example.com/
MEDIA_PUBLIC_URL=http://localhost:4000/media/
AVATAR_MAX_BYTES=2097152

# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# Leave the keys out on AWS to use the instance/task role. Set an endpoint for R2, MinIO, etc.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=avatars/
